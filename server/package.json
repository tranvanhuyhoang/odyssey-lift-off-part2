{
  "name": "catstronauts-server",
  "version": "1.0.0",
  "description": "back-end demo app for Apollo's lift-off II course",
  "main": "dist/src/index.js",
  "scripts": {
    "start": "nodemon --watch src --watch datasources --ext ts,js --exec \"ts-node src/index.ts\"",
    "build": "tsc",
    "serve": "node dist/src/index.js",
    "generate": "graphql-codegen"
  },
  "dependencies": {
    "@apollo/datasource-rest": "^6.4.1",
    "@apollo/server": "^5.5.1",
    "@graphql-tools/mock": "^8.7.6",
    "@graphql-tools/schema": "^9.0.4",
    "graphql": "^16.6.0",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-resolvers": "^6.0.1",
    "@types/node": "^22.19.19",
    "dotenv": "^8.2.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "author": "Raphael Terrier @R4ph-t",
  "license": "MIT",
  "private": true
}
